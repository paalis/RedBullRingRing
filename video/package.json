{
  "name": "redbullringring-video",
  "version": "1.0.0",
  "description": "Remotion-videoer for Red Bull Ring 2027",
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "render": "remotion render src/index.ts RedBullRingIntro out/red-bull-ring-intro.mp4",
    "still": "remotion still src/index.ts RedBullRingIntro out/poster.png --frame=90",
    "assets": "node scripts/prepare-assets.mjs",
    "predev": "npm run assets",
    "prebuild": "npm run assets",
    "prerender": "npm run assets",
    "prestill": "npm run assets",
    "render:intro": "node scripts/render-intro.mjs"
  },
  "repository": {},
  "license": "UNLICENSED",
  "dependencies": {
    "@remotion/cli": "4.0.539",
    "@remotion/fonts": "4.0.539",
    "@remotion/media": "4.0.539",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.539",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
